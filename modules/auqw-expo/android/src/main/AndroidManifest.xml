<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- dataSync FGS keeps long download transfers alive under Doze. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- NetworkCallback registration + active-network capability reads
       (connectivity monitor) need this normal permission. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- setWakeMode(WAKE_MODE_LOCAL) on the warm player. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- API 33+: without it the MediaSession notification the service
       posts is silently dropped — lock-screen/SystemUI controls would
       have nothing to show. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- Single warm player lives in the service so it survives the JS
         UI being torn down; module manifests merge into the app. -->
    <service
        android:name="expo.modules.auqwexpo.AuqwMediaSessionService"
        android:exported="true"
        android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>
    <!-- JS-side DownloadManager drives this via downloadsActiveChanged;
         it carries no state of its own. -->
    <service
        android:name="expo.modules.auqwexpo.AuqwDownloadService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
  </application>
</manifest>
