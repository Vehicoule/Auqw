# Rust → iOS build product (rebuild via tooling/build-ios-bindings.sh)
modules/auqw-expo/ios/AuqwMobileBindingsFFI.xcframework/

# Agent worktrees
.worktrees/

# Plugin artifacts synced from auqw-plugins (rebuild via pnpm sync-plugins)
apps/mobile/assets/plugins/

# Local env
.envrc

# Electron bundles (rebuild via `pnpm --filter auqw-desktop build`)
apps/desktop/dist/
