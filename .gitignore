/target
node_modules/
**/*.rs.bk
.DS_Store

# Expo prebuild output (reproducible via `expo prebuild`)
apps/mobile/android/
apps/mobile/ios/

# Gradle build output
**/android/build/
**/android/.gradle/
**/android/.kotlin/
.gradle/

# Rust → Android build product (rebuild via tooling/build-android-bindings.sh)
modules/auqw-expo/android/src/main/jniLibs/

# Rust → iOS build product (rebuild via tooling/build-ios-bindings.sh)
modules/auqw-expo/ios/AuqwMobileBindingsFFI.xcframework/

# Agent worktrees
.worktrees/

# Plugin artifacts synced from auqw-plugins (rebuild via pnpm sync-plugins)
apps/mobile/assets/plugins/

# Local env
.envrc

# Electron bundles (rebuild via `pnpm --filter auqw-desktop build`)
apps/desktop/dist/

# electron-builder package output (rebuild via `pnpm --filter auqw-desktop dist`)
apps/desktop/dist-packages/

# Provider artifacts synced for packaging (rebuild via tooling/sync-plugins.mjs)
apps/desktop/plugins/

# sync-plugins staging dirs — cleaned on exit; only SIGKILL leaves residue
**/.sync-stage-*/
