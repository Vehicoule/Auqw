{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auqw.dev/contract/manifest.schema.json",
  "title": "Auqw plugin manifest v0",
  "type": "object",
  "required": ["id", "version", "abi", "capabilities", "permissions", "artifact"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "abi": {
      "const": "0.1.0"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["playback.resolve"]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(network:(\\*\\.)?[a-z0-9.-]+|pot-provider)$"
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "digest"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
