{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auqw.dev/contract/capabilities.schema.json",
  "title": "Auqw plugin capability payloads and results (ABI 0.1.0)",
  "description": "Wire types for the declared manifest capabilities. The top-level oneOf validates a named {capability, payload} or {capability, result} envelope so fixtures can pin a capability and direction without guessing.",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": [
        "provider",
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "track",
            "album",
            "artist",
            "playlist"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "entityRef": {
      "type": "object",
      "required": [
        "provider",
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "album",
            "artist",
            "playlist"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artworkRef": {
      "type": "object",
      "required": [
        "url",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "trackMetadata": {
      "type": "object",
      "required": [
        "source_ref",
        "title",
        "artist",
        "album",
        "duration_ms",
        "release_year",
        "artwork",
        "explicit",
        "genre",
        "storefront"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artist": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "album": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "release_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "artwork": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artworkRef"
          },
          "maxItems": 8
        },
        "explicit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "storefront": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "artist_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "album_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "isrc": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 16
        }
      }
    },
    "entityMetadata": {
      "type": "object",
      "required": [
        "source_ref",
        "kind",
        "title",
        "artwork"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/entityRef"
        },
        "kind": {
          "enum": [
            "album",
            "artist",
            "playlist"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artwork": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artworkRef"
          },
          "maxItems": 8
        },
        "group": {
          "enum": [
            "discography",
            "related",
            "featured",
            "appears-on",
            null
          ],
          "description": "Section tag on `related[]` entries \u2014 which upstream shelf the entity came from; null/absent elsewhere."
        }
      }
    },
    "recordingQuery": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "album",
        "duration_ms",
        "version_labels",
        "isrc"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artist": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "album": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "version_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "isrc": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "catalogSearchPayload": {
      "type": "object",
      "required": [
        "query",
        "limit",
        "storefront"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "storefront": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{2}$"
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "track",
              "album",
              "artist",
              "playlist"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "description": "Scopes the query to these result kinds; absent asks for everything the provider serves."
        },
        "continuation": {
          "type": "string",
          "minLength": 1,
          "description": "Next-page token from a prior result; rides with the same query/kinds."
        }
      }
    },
    "catalogSearchResult": {
      "type": "object",
      "required": [
        "items",
        "storefront"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackMetadata"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityMetadata"
          },
          "maxItems": 200
        },
        "top_hit": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "track"
                },
                "item": {
                  "$ref": "#/$defs/trackMetadata"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "entity"
                },
                "item": {
                  "$ref": "#/$defs/entityMetadata"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The provider's single best hit; tagged because source_ref.kind alone is ambiguous between track and entity rows."
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "storefront": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "catalogMetadataPayload": {
      "type": "object",
      "required": [
        "refs"
      ],
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "maxItems": 200
        }
      }
    },
    "catalogMetadataResult": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackMetadata"
          }
        }
      }
    },
    "catalogArtworkPayload": {
      "type": "object",
      "required": [
        "ref",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "size": {
          "enum": [
            600,
            1200
          ]
        }
      }
    },
    "catalogArtworkResult": {
      "type": "object",
      "required": [
        "source_ref",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artworkRef"
          },
          "maxItems": 8
        }
      }
    },
    "catalogEntityPayload": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/entityRef"
        }
      }
    },
    "catalogEntityResult": {
      "type": "object",
      "required": [
        "entity",
        "items",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/entityMetadata"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackMetadata"
          }
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityMetadata"
          },
          "maxItems": 200
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "catalogSuggestPayload": {
      "type": "object",
      "required": [
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "catalogSuggestResult": {
      "type": "object",
      "required": [
        "suggestions"
      ],
      "additionalProperties": false,
      "properties": {
        "suggestions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "playbackCandidatesPayload": {
      "type": "object",
      "required": [
        "query",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/recordingQuery"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "access_token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "playbackCandidatesResult": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackMetadata"
          }
        }
      }
    },
    "playbackResolvePayload": {
      "type": "object",
      "required": [
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "target_bitrate_kbps": {
          "type": "integer",
          "minimum": 1
        },
        "prefer": {
          "type": "array",
          "items": {
            "enum": [
              "audio/webm",
              "audio/mp4"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "pin_itag": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "resume_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "access_token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "playbackResolveResult": {
      "type": "object",
      "required": [
        "url",
        "mime",
        "bitrate_kbps",
        "expires_at_ms",
        "client"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "bitrate_kbps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "expires_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "content_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "client": {
          "type": "string",
          "minLength": 1
        },
        "itag": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "headers": {
          "type": [
            "object",
            "null"
          ],
          "description": "Request headers the mint requires on every stream fetch (e.g. the minting client's User-Agent). Host-controlled names (range, host, content-length, connection, transfer-encoding, accept-encoding, te, trailer, upgrade, expect, keep-alive, proxy-authenticate, proxy-authorization, www-authenticate, authorization, cookie, set-cookie) are rejected.",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "lyricsQuery": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "album",
        "duration_ms",
        "isrc"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artist": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "album": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "isrc": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "lyricsMatched": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "album",
        "duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artist": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "album": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "lyricsLine": {
      "type": "object",
      "required": [
        "t_ms",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "lyricsPlainPayload": {
      "type": "object",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/lyricsQuery"
        }
      }
    },
    "lyricsPlainResult": {
      "type": "object",
      "required": [
        "state",
        "matched"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "plain",
            "instrumental",
            "absent"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "matched": {
          "oneOf": [
            {
              "$ref": "#/$defs/lyricsMatched"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lyricsSyncedPayload": {
      "type": "object",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/lyricsQuery"
        }
      }
    },
    "lyricsSyncedResult": {
      "type": "object",
      "required": [
        "state",
        "matched"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "synced",
            "instrumental",
            "absent"
          ]
        },
        "lines": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/lyricsLine"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "matched": {
          "oneOf": [
            {
              "$ref": "#/$defs/lyricsMatched"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "radioSeedPayload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "source_ref": {
              "$ref": "#/$defs/sourceRef"
            },
            "access_token": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        {
          "type": "object",
          "required": [
            "continuation"
          ],
          "additionalProperties": false,
          "properties": {
            "continuation": {
              "type": "string",
              "minLength": 1
            },
            "access_token": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      ]
    },
    "radioSeedResult": {
      "type": "object",
      "required": [
        "items",
        "continuation"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackMetadata"
          }
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "catalog.search"
        },
        "payload": {
          "$ref": "#/$defs/catalogSearchPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "catalog.metadata"
        },
        "payload": {
          "$ref": "#/$defs/catalogMetadataPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "catalog.artwork"
        },
        "payload": {
          "$ref": "#/$defs/catalogArtworkPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "catalog.entity"
        },
        "payload": {
          "$ref": "#/$defs/catalogEntityPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "catalog.suggest"
        },
        "payload": {
          "$ref": "#/$defs/catalogSuggestPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "playback.candidates"
        },
        "payload": {
          "$ref": "#/$defs/playbackCandidatesPayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "playback.resolve"
        },
        "payload": {
          "$ref": "#/$defs/playbackResolvePayload"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "lyrics.plain"
