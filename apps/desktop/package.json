{
  "name": "auqw-desktop",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "auqw desktop shell — plugin-resolved audio client",
  "type": "module",
  "main": "dist/main/index.js",
  "desktopName": "auqw",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "pnpm build && electron .",
    "dist": "pnpm run build && cargo build --locked --release -p auqw-node-bindings && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types src/desktop.test.ts"
  },
  "devDependencies": {
    "@auqw/application": "workspace:*",
    "@auqw/storage-sqlite": "workspace:*",
    "@auqw/ui-shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "26.6.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "bonjour-service": "1.4.4",
    "electron": "44.5.0",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "music-metadata": "11.16.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@auqw/app-shell": "workspace:*",
    "@auqw/design-tokens": "workspace:*",
    "@auqw/ui-web": "workspace:*",
    "bgutils-js": "4.0.3",
    "jsdom": "^30.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "undici": "^8.11.2"
  }
}
